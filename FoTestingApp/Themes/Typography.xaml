<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      The M3 type scale, the same sizes and weights as jinom-assets (DESIGN.md Kontrak §5): every text
      on a screen uses one of these styles, never a FontSize of its own. Segoe UI, as in the web app.
      Body and title text is on-surface; give supporting text Foreground="{DynamicResource OnSurfaceVariantBrush}".
    -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="Text.DisplaySmall" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="LineHeight" Value="40"/>
    </Style>
    <Style x:Key="Text.HeadlineSmall" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="LineHeight" Value="32"/>
    </Style>
    <Style x:Key="Text.TitleLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="LineHeight" Value="28"/>
    </Style>
    <Style x:Key="Text.TitleMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="Text.BodyLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="24"/>
    </Style>
    <Style x:Key="Text.BodyMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Text.BodySmall" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>
    <Style x:Key="Text.LabelLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="Text.LabelMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="Text.LabelSmall" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- Supporting text: body medium in on-surface-variant. -->
    <Style x:Key="Text.Supporting" TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMedium}">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/>
    </Style>
    <!-- A field's error under it: body small in error. -->
    <Style x:Key="Text.FieldError" TargetType="TextBlock" BasedOn="{StaticResource Text.BodySmall}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Margin" Value="16,4,16,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
</ResourceDictionary>

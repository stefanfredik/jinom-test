<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Jinom M3 colour roles, light scheme: the same roles and values as jinom-assets
      (resources/css/app.css, DESIGN.md Kontrak §4; seed #10B981). Screens use these brushes by
      role, never a raw colour. Generated together with the other scheme so both hold the same keys;
      ThemeService swaps one for the other.
    -->
    <Color x:Key="PrimaryColor">#006C49</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimaryContainerColor">#6FFBBE</Color>
    <Color x:Key="OnPrimaryContainerColor">#002113</Color>
    <Color x:Key="SecondaryContainerColor">#D0E8D8</Color>
    <Color x:Key="OnSecondaryContainerColor">#0A1F16</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLowestColor">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLowColor">#F2F4F0</Color>
    <Color x:Key="SurfaceContainerColor">#ECEEEA</Color>
    <Color x:Key="SurfaceContainerHighColor">#E7E9E5</Color>
    <Color x:Key="SurfaceContainerHighestColor">#E1E3DF</Color>
    <Color x:Key="OnSurfaceColor">#191C1A</Color>
    <Color x:Key="OnSurfaceVariantColor">#404943</Color>
    <Color x:Key="OutlineColor">#707973</Color>
    <Color x:Key="OutlineVariantColor">#C0C9C1</Color>
    <Color x:Key="ErrorColor">#BA1A1A</Color>
    <Color x:Key="OnErrorColor">#FFFFFF</Color>
    <Color x:Key="ErrorContainerColor">#FFDAD6</Color>
    <Color x:Key="OnErrorContainerColor">#410002</Color>
    <Color x:Key="InverseSurfaceColor">#2E312F</Color>
    <Color x:Key="InverseOnSurfaceColor">#EFF1ED</Color>
    <Color x:Key="ScrimColor">#66000000</Color>
    <Color x:Key="StatusOnlineColor">#146C2E</Color>
    <Color x:Key="StatusOnlineContainerColor">#B4F1BD</Color>
    <Color x:Key="StatusOnlineOnContainerColor">#002109</Color>
    <Color x:Key="StatusWarningColor">#7A5900</Color>
    <Color x:Key="StatusWarningContainerColor">#FFDEA1</Color>
    <Color x:Key="StatusWarningOnContainerColor">#261900</Color>
    <Color x:Key="StatusOfflineColor">#BA1A1A</Color>
    <Color x:Key="StatusOfflineContainerColor">#FFDAD6</Color>
    <Color x:Key="StatusOfflineOnContainerColor">#410002</Color>
    <Color x:Key="StatusUnknownColor">#707973</Color>
    <Color x:Key="StatusUnknownContainerColor">#E1E3DF</Color>
    <Color x:Key="StatusUnknownOnContainerColor">#404943</Color>
    <Color x:Key="InfoColor">#2E5AAC</Color>
    <Color x:Key="InfoContainerColor">#D9E2FF</Color>
    <Color x:Key="OnInfoContainerColor">#001944</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}"/>
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowestColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}"/>
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}"/>
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}"/>
    <SolidColorBrush x:Key="InverseSurfaceBrush" Color="{StaticResource InverseSurfaceColor}"/>
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="{StaticResource InverseOnSurfaceColor}"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}"/>
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource StatusOnlineColor}"/>
    <SolidColorBrush x:Key="StatusOnlineContainerBrush" Color="{StaticResource StatusOnlineContainerColor}"/>
    <SolidColorBrush x:Key="StatusOnlineOnContainerBrush" Color="{StaticResource StatusOnlineOnContainerColor}"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}"/>
    <SolidColorBrush x:Key="StatusWarningContainerBrush" Color="{StaticResource StatusWarningContainerColor}"/>
    <SolidColorBrush x:Key="StatusWarningOnContainerBrush" Color="{StaticResource StatusWarningOnContainerColor}"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOfflineColor}"/>
    <SolidColorBrush x:Key="StatusOfflineContainerBrush" Color="{StaticResource StatusOfflineContainerColor}"/>
    <SolidColorBrush x:Key="StatusOfflineOnContainerBrush" Color="{StaticResource StatusOfflineOnContainerColor}"/>
    <SolidColorBrush x:Key="StatusUnknownBrush" Color="{StaticResource StatusUnknownColor}"/>
    <SolidColorBrush x:Key="StatusUnknownContainerBrush" Color="{StaticResource StatusUnknownContainerColor}"/>
    <SolidColorBrush x:Key="StatusUnknownOnContainerBrush" Color="{StaticResource StatusUnknownOnContainerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoContainerBrush" Color="{StaticResource InfoContainerColor}"/>
    <SolidColorBrush x:Key="OnInfoContainerBrush" Color="{StaticResource OnInfoContainerColor}"/>

    <!-- MaterialDesignInXAML brushes, pointed at the roles. -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light" Color="{StaticResource PrimaryContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light.Foreground" Color="{StaticResource OnPrimaryContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark.Foreground" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Foreground" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Light" Color="{StaticResource SecondaryContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Light.Foreground" Color="{StaticResource OnSecondaryContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Dark" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Dark.Foreground" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ForegroundLight" Color="{StaticResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Card.Background" Color="{StaticResource SurfaceContainerLowestColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Card.Border" Color="{StaticResource OutlineVariantColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Separator.Background" Color="{StaticResource OutlineVariantColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.Border" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.OutlineBorder" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.OutlineInactiveBorder" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.HoverBorder" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.FilledBackground" Color="{StaticResource SurfaceContainerHighestColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.PasswordBox.Border" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.PasswordBox.OutlineBorder" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.PasswordBox.OutlineInactiveBorder" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.PasswordBox.HoverBorder" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.Border" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.OutlineBorder" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.OutlineInactiveBorder" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.HoverBorder" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.Popup.LightBackground" Color="{StaticResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.Popup.LightForeground" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.Popup.DarkBackground" Color="{StaticResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.Popup.DarkForeground" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.DataGrid.RowHoverBackground" Color="{StaticResource SurfaceContainerLowColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.DataGrid.Selected" Color="{StaticResource SecondaryContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.DataGrid.Border" Color="{StaticResource OutlineVariantColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.DataGrid.ColumnHeaderForeground" Color="{StaticResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ListBoxItem.Selected" Color="{StaticResource SecondaryContainerColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ScrollBar.Foreground" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.SnackBar.Background" Color="{StaticResource InverseSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ToolTip.Background" Color="{StaticResource InverseSurfaceColor}"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.ValidationError" Color="{StaticResource ErrorColor}"/>
</ResourceDictionary>

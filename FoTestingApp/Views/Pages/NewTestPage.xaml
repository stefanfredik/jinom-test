<Page x:Class="FoTestingApp.Views.Pages.NewTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Pengujian Baru">

    <Page.Resources>
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThinScrollbarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource TextLightBrush}" Opacity="0.25" BorderBrush="Transparent" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="PART_Track" Property="Thumb.Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <!-- ═══ Stage 1: Landing — Big circular start button ═══ -->
        <Grid x:Name="LandingContainer" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="Jinom Testing" FontSize="36" FontWeight="Black" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Mulai pengujian jaringan" FontSize="16" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,48"/>

                <!-- Big Circular Start Button -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,48">
                    <!-- Outer glow ring -->
                    <Ellipse Width="220" Height="220" StrokeThickness="3">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#3022c55e"/>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <!-- Middle ring -->
                    <Ellipse Width="200" Height="200" StrokeThickness="2">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#2022c55e"/>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <!-- Main button -->
                    <Button x:Name="StartLandingBtn" Width="180" Height="180" Click="StartLandingBtn_Click"
                            Style="{StaticResource MaterialDesignFloatingActionButton}"
                            Foreground="White" Cursor="Hand" BorderBrush="Transparent">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22C55E" Offset="0.0"/>
                                <GradientStop Color="#16A34A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Play" Width="56" Height="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="MULAI" FontSize="16" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="Klik tombol di atas untuk memulai pengujian" FontSize="13" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Stage 2: Location Selection — POP or CPE ═══ -->
        <Grid x:Name="LocationContainer" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700">
                <!-- Title -->
                <TextBlock Text="Pilih Lokasi Pengujian" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Tentukan lokasi pengujian yang akan dilakukan" FontSize="16" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,48"/>

                <!-- POP and CPE Cards -->
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- POP Card -->
                    <Border Grid.Column="0" Style="{StaticResource HoverCardStyle}"
                            MouseLeftButtonUp="PopCard_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="Black" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" Margin="32">
                            <!-- Icon Circle -->
                            <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,0,20" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ServerNetwork" Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="POP" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Point of Presence" FontSize="13" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Pengujian di sisi POP" FontSize="12" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                            <Button Content="Pilih POP" Click="PopCard_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                                    Foreground="White" FontWeight="Bold" Height="44" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- CPE Card -->
                    <Border Grid.Column="2" Style="{StaticResource HoverCardStyle}"
                            MouseLeftButtonUp="CpeCard_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="Black" Opacity="0.06"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" Margin="32">
                            <!-- Icon Circle -->
                            <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,0,20" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="RouterWireless" Width="36" Height="36" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CPE" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Customer Premises Equipment" FontSize="13" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Pengujian di sisi pelanggan dan perangkat akhir" FontSize="12" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                            <Button Content="Pilih CPE" Click="CpeCard_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                                    Foreground="White" FontWeight="Bold" Height="44" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Back button (Bypassed) -->
                <Button Content="Kembali" Click="BackToLanding_Click" Margin="0,32,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource TextLightBrush}"
                        HorizontalAlignment="Center" Height="40" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Stage 3: Form Area — Customer data input ═══ -->
        <ScrollViewer x:Name="FormContainer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="24,20,24,20">
                <!-- Header -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock x:Name="FormTitle" Text="Customer Network Test" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                    <TextBlock x:Name="FormSubtitle" Text="DIAGNOSTIC SUITE FOR CPE VERIFICATION" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextLightBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Customer Configuration Panel -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <!-- Section Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="8" Padding="8">
                                <materialDesign:PackIcon x:Name="FormSectionIcon" Kind="AccountPlus" Foreground="{DynamicResource PrimaryBrush}" Width="24" Height="24"/>
                            </Border>
                            <TextBlock x:Name="FormSectionTitle" Text="Data Pengujian" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- Data Fields -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Search Dropdowns (Full Width) -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Selected Details Card (Full Width) -->
                                <RowDefinition Height="Auto"/> <!-- Row 2: Name (Left) & Package (Right) -->
                                <RowDefinition Height="Auto"/> <!-- Row 3: Address (Full Width) -->
                                <RowDefinition Height="Auto"/> <!-- Row 4: Notes (Full Width) -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Search/Select ComboBoxes (Spans both columns) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" x:Name="PopSelectionPanel" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBlock Text="PILIH POP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PopComboBox"
                                          IsEditable="True"
                                          TextSearch.TextPath="DisplayName"
                                          TextBoxBase.TextChanged="PopComboBox_TextChanged"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Ketik untuk mencari POP..."
                                          materialDesign:HintAssist.IsFloating="False"
                                          materialDesign:TextFieldAssist.LeadingIcon="ServerNetwork"
                                          Height="44" FontSize="14" Padding="12,8"
                                          SelectionChanged="PopComboBox_SelectionChanged"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          BorderBrush="{DynamicResource BorderLightBrush}"
                                          Background="Transparent">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="ServerNetwork" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                                                    <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{DynamicResource TextLightBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="PopStatusText" FontSize="11" Foreground="{DynamicResource TextLightBrush}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CustomerSelectionPanel" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBlock Text="PILIH PELANGGAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CustomerComboBox"
                                          IsEditable="True"
                                          TextSearch.TextPath="DisplayName"
                                          TextBoxBase.TextChanged="CustomerComboBox_TextChanged"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Ketik untuk mencari pelanggan..."
                                          materialDesign:HintAssist.IsFloating="False"
                                          materialDesign:TextFieldAssist.LeadingIcon="DatabaseSearch"
                                          Height="44" FontSize="14" Padding="12,8"
                                          SelectionChanged="CustomerComboBox_SelectionChanged"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          BorderBrush="{DynamicResource BorderLightBrush}"
                                          Background="Transparent">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="Auto"/>
                                                     <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Account" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                                                    <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{DynamicResource TextLightBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="CustomerStatusText" FontSize="11" Foreground="{DynamicResource TextLightBrush}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Row 1: Selected Details Card (Read-only) -->
                            <Border x:Name="SelectedDetailsCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Black" Opacity="0.04"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon Circle -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <materialDesign:PackIcon x:Name="DetailsCardIcon" Kind="CheckCircle" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Details Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Header Row: Name & Badges -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock x:Name="DetailsNameText" Text="Nama" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            
                                            <Border x:Name="DetailsSiteIdBadge" Background="{DynamicResource PrimaryLightBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DetailsSiteIdText" Text="SITE-ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                            </Border>
                                            
                                            <Border x:Name="DetailsPackageBadge" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="DetailsPackageText" Text="100 Mbps" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                        
                                        <!-- Address Row -->
                                        <Grid x:Name="DetailsAddressPanel">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="MapMarker" Width="16" Height="16" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Top" Margin="0,2,6,0" Grid.Column="0"/>
                                            <TextBlock x:Name="DetailsAddressText" Text="Alamat" FontSize="13" Foreground="{DynamicResource TextLightBrush}" TextWrapping="Wrap" Grid.Column="1"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Edit Button -->
                                    <Button Grid.Column="2" x:Name="BtnEditDetails" Style="{StaticResource MaterialDesignIconButton}"
                                            Click="BtnEditDetails_Click" ToolTip="Ubah data manual" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Pencil" Width="22" Height="22" Foreground="{DynamicResource TextLightBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Row 2: Name and Package Fields (Side-by-Side) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" x:Name="NameFieldPanel" Margin="0,0,0,12">
                                <TextBlock x:Name="NameFieldLabel" Text="NAMA PELANGGAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="FullNameBox"
                                         materialDesign:HintAssist.Hint="Masukkan nama"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Height="44" FontSize="14" Padding="12,8"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.LeadingIcon="Account"
                                         BorderBrush="{DynamicResource BorderLightBrush}"
                                         Background="Transparent"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" x:Name="PackageFieldPanel" Margin="0,0,0,12">
                                <TextBlock x:Name="PackageFieldLabel" Text="PAKET INTERNET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PackageMbpsBox"
                                         materialDesign:HintAssist.Hint="Contoh: 100 Mbps"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Height="44" FontSize="14" Padding="12,8"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.LeadingIcon="Speedometer"
                                         BorderBrush="{DynamicResource BorderLightBrush}"
                                         Background="Transparent"/>
                            </StackPanel>

                            <!-- Row 3: Address Field (Spans both columns) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="AddressFieldPanel" Margin="0,0,0,12">
                                <TextBlock Text="ALAMAT PELANGGAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="AddressBox"
                                         materialDesign:HintAssist.Hint="Masukkan alamat pelanggan"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Height="44" FontSize="14" Padding="12,8"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.LeadingIcon="MapMarker"
                                         BorderBrush="{DynamicResource BorderLightBrush}"
                                         Background="Transparent"/>
                            </StackPanel>

                            <!-- Row 4: Notes Field (Spans both columns) -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="NotesFieldPanel" Margin="0,4,0,0">
                                <TextBlock Text="CATATAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NotesBox"
                                         materialDesign:HintAssist.Hint="Catatan tambahan (opsional)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Height="68" FontSize="14" Padding="12,8"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         materialDesign:TextFieldAssist.LeadingIcon="NoteTextOutline"
                                         BorderBrush="{DynamicResource BorderLightBrush}"
                                         Background="Transparent"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Toolbar -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="12" Margin="0,0,0,0"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackToLocationBtn" Grid.Column="0"
                                Height="44" Padding="16,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                BorderBrush="{DynamicResource BorderLightBrush}" Foreground="{DynamicResource TextLightBrush}"
                                Click="BackToLocation_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Kembali" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="StartTestBtn" Grid.Column="2"
                                Height="44" Padding="28,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Foreground="White"
                                Click="StartTestBtn_Click"
                                BorderBrush="Transparent"
                                Cursor="Hand">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22C55E" Offset="0.0"/>
                                    <GradientStop Color="#16A34A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Mulai Pengujian" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Stage 4: Progress Overlay ═══ -->
        <Grid x:Name="ProgressContainer" Visibility="Collapsed" Background="{DynamicResource AppBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" MaxWidth="640" Margin="24,12,24,12" Width="640">
                    
                    <!-- Title Section -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="Pengujian sedang berjalan" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Menganalisis kinerja dan keamanan jaringan Anda" FontSize="13" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stepper Progress UI -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Step 1: Network -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Border x:Name="Step1Circle" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" Margin="0,0,0,6">
                                    <materialDesign:PackIcon x:Name="Step1Icon" Kind="LanConnect" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Step1Text" Text="NETWORK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ProgressBar x:Name="Line1" Grid.Column="1" Value="0" Maximum="100" Height="4" VerticalAlignment="Top" Margin="0,18,0,0" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderLightBrush}" BorderThickness="0"/>
                            
                            <!-- Step 2: Application -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Border x:Name="Step2Circle" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="2" Margin="0,0,0,6">
                                    <materialDesign:PackIcon x:Name="Step2Icon" Kind="Web" Foreground="{DynamicResource TextLightBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Step2Text" Text="APPLICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ProgressBar x:Name="Line2" Grid.Column="3" Value="0" Maximum="100" Height="4" VerticalAlignment="Top" Margin="0,18,0,0" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderLightBrush}" BorderThickness="0"/>
                            
                            <!-- Step 3: Speedtest -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <Border x:Name="Step3Circle" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="2" Margin="0,0,0,6">
                                    <materialDesign:PackIcon x:Name="Step3Icon" Kind="Speedometer" Foreground="{DynamicResource TextLightBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Step3Text" Text="BANDWIDTH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Current Task Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="#1A22c55e" BorderThickness="1" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Color="{DynamicResource PrimaryColor}" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel Margin="16">
                            <!-- Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="CURRENT ACTIVITY" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CurrentActivityText" Text="Preparing Tests..." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                                        <!-- Ping dot simulation (pulsating heartbeat) -->
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                 <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1.0" To="0.2" Duration="0:0:0.6"
                                                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,4">
                                    <TextBlock x:Name="TaskCountText" Text="Task 1 of 7" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                                </Border>
                            </Grid>
                            
                            <!-- Internal Progress bar -->
                            <ProgressBar x:Name="SubTaskProgressBar" Value="0" Maximum="100" Height="8" materialDesign:ButtonAssist.CornerRadius="4" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource AppBackgroundBrush}" Margin="0,0,0,8"/>
                            
                            <Grid>
                                <TextBlock x:Name="SubTaskDetailText" Text="Initializing diagnostic engine..." FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextLightBrush}" FontStyle="Italic" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostic Log List -->
                    <StackPanel Margin="0,0,0,12">
                        <!-- Terminal Window Header -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" Padding="12,4">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <!-- macOS-style window controls -->
                                    <Ellipse Width="8" Height="8" Fill="#FF5F56" Margin="0,0,6,0"/>
                                    <Ellipse Width="8" Height="8" Fill="#FFBD2E" Margin="0,0,6,0"/>
                                    <Ellipse Width="8" Height="8" Fill="#27C93F" Margin="0,0,12,0"/>
                                    <TextBlock Text="DIAGNOSTIC LOG CONSOLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Pulsating dot -->
                                    <Ellipse x:Name="LiveLogDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.2" Duration="0:0:0.8"
                                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="LIVE STREAMING" FontSize="10" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,0,12,12" Padding="16,8"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="LogsScrollViewer" Height="180" VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinScrollbarStyle}"/>
                                </ScrollViewer.Resources>
                                <StackPanel x:Name="DiagnosticLogsPanel">
                                    <!-- Logs injected here dynamically by code-->
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Action Area -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <!-- End/Cancel Button -->
                        <Button x:Name="EndTestBtn" Foreground="{DynamicResource FailRedBrush}" Background="Transparent" BorderThickness="0"
                                Style="{StaticResource MaterialDesignFlatButton}" Height="40" Padding="24,0" Click="EndTestBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="EndTestBtnText" Text="CANCEL DIAGNOSTICS" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══ Stage 5: Results Detail ═══ -->
        <Grid x:Name="ResultsContainer" Visibility="Collapsed" Background="{DynamicResource AppBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" MaxWidth="720" Margin="24,20,24,20" Width="720">

                    <!-- Summary Header -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pengujian Selesai" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ResultSummaryText" Text="" FontSize="14" Foreground="{DynamicResource TextLightBrush}"/>
                            </StackPanel>

                            <!-- Overall Status Badge -->
                            <Border x:Name="ResultStatusBadge" Grid.Column="1" CornerRadius="16" Padding="20,10" VerticalAlignment="Center"
                                    Background="{DynamicResource PrimaryLightBrush}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="ResultStatusText" Text="PASS" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PassGreenBrush}"/>
                                    <TextBlock x:Name="ResultScoreText" Text="7/7 test passed" FontSize="11" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Results Cards -->
                    <StackPanel x:Name="ResultCardsPanel">
                        <!-- Filled dynamically -->
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Height="44" Padding="24,0" Margin="0,0,12,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="White"
                                Click="NewTestFromResults_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Pengujian Baru" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RetryFailedBtn" Height="44" Padding="24,0" Margin="0,0,12,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Background="{DynamicResource WarnYellowBrush}" BorderBrush="{DynamicResource WarnYellowBrush}" Foreground="Black"
                                Click="RetryFailedBtn_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Coba Ulang Gagal" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SaveReportBtn"
                                Height="44" Padding="24,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                BorderBrush="{DynamicResource BorderLightBrush}" Foreground="{DynamicResource TextDarkBrush}"
                                Click="SaveReportBtn_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Simpan PDF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

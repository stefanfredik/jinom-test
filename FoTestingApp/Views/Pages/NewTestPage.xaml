<Page x:Class="FoTestingApp.Views.Pages.NewTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Pengujian baru">

    <!--
      A test in four steps, one visible at a time: where (customer or POP) → who (the site's data) →
      running (stepper, current task, results as they come) → results (verdict, what was not saved,
      every test). One primary action per step.
    -->
    <Grid>

        <!-- ═══ 1. Where ═══ -->
        <ScrollViewer x:Name="LocationContainer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="840" HorizontalAlignment="Stretch">
                <TextBlock Text="Pengujian baru" Style="{StaticResource Text.HeadlineSmall}" Margin="0,8,0,4"/>
                <TextBlock Text="Pilih lokasi yang akan diuji." Style="{StaticResource Text.Supporting}" Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CustomerChoice" Grid.Column="0" Style="{StaticResource M3.ChoiceCard}" Click="CustomerChoice_Click"
                            AutomationProperties.Name="Uji di pelanggan">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource PrimaryContainerBrush}" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="HomeVariantOutline" Width="28" Height="28" Foreground="{DynamicResource OnPrimaryContainerBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pelanggan" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,4"/>
                            <TextBlock Text="Di rumah pelanggan, dari perangkatnya (CPE). Hasil dinilai terhadap paket pelanggan." Style="{StaticResource Text.Supporting}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PopChoice" Grid.Column="2" Style="{StaticResource M3.ChoiceCard}" Click="PopChoice_Click"
                            AutomationProperties.Name="Uji di POP">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SecondaryContainerBrush}" HorizontalAlignment="Left" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="ServerNetwork" Width="28" Height="28" Foreground="{DynamicResource OnSecondaryContainerBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="POP" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,4"/>
                            <TextBlock Text="Di Point of Presence. Speedtest dinilai dari kecepatan terukur, tanpa paket." Style="{StaticResource Text.Supporting}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 2. Who ═══ -->
        <ScrollViewer x:Name="FormContainer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="24" MaxWidth="840" HorizontalAlignment="Stretch">
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToLocationBtn" Style="{StaticResource M3.IconButton}" Click="BackToLocation_Click" Margin="-8,0,8,0"
                            VerticalAlignment="Top" ToolTip="Kembali" AutomationProperties.Name="Kembali">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="FormTitle" Text="Uji di pelanggan" Style="{StaticResource Text.HeadlineSmall}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="FormSubtitle" Text="Cari pelanggan, periksa datanya, lalu mulai." Style="{StaticResource Text.Supporting}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource M3.Card}" Padding="24">
                    <StackPanel>
                        <!-- Search: POP -->
                        <StackPanel x:Name="PopSelectionPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <ComboBox x:Name="PopComboBox" Style="{StaticResource M3.ComboField}"
                                      IsEditable="True" TextSearch.TextPath="DisplayName"
                                      materialDesign:HintAssist.Hint="POP (ketik untuk mencari)"
                                      materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                      TextBoxBase.TextChanged="PopComboBox_TextChanged"
                                      SelectionChanged="PopComboBox_SelectionChanged"
                                      DropDownOpened="PopComboBox_DropDownOpened"
                                      HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="Cari POP">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyLarge}"/>
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Supporting}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ProgressBar x:Name="PopLoadingBar" Style="{StaticResource M3.LinearProgress}" IsIndeterminate="True" Visibility="Hidden" Margin="0,4,0,0"/>
                            <TextBlock x:Name="PopStatusText" Style="{StaticResource Text.BodySmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="16,4,16,0"/>
                        </StackPanel>

                        <!-- Search: customer -->
                        <StackPanel x:Name="CustomerSelectionPanel" Margin="0,0,0,16">
                            <ComboBox x:Name="CustomerComboBox" Style="{StaticResource M3.ComboField}"
                                      IsEditable="True" TextSearch.TextPath="DisplayName"
                                      materialDesign:HintAssist.Hint="Pelanggan (ketik nama atau nomor layanan)"
                                      materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                      TextBoxBase.TextChanged="CustomerComboBox_TextChanged"
                                      SelectionChanged="CustomerComboBox_SelectionChanged"
                                      DropDownOpened="CustomerComboBox_DropDownOpened"
                                      HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="Cari pelanggan">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.BodyLarge}"/>
                                            <TextBlock Style="{StaticResource Text.Supporting}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding ServiceNumber, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Address, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ProgressBar x:Name="CustomerLoadingBar" Style="{StaticResource M3.LinearProgress}" IsIndeterminate="True" Visibility="Hidden" Margin="0,4,0,0"/>
                            <TextBlock x:Name="CustomerStatusText" Style="{StaticResource Text.BodySmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="16,4,16,0"/>
                        </StackPanel>

                        <!-- The chosen site, read-only -->
                        <Border x:Name="SelectedDetailsCard" Style="{StaticResource M3.FilledCard}" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource M3.LeadingIcon}" Background="{DynamicResource PrimaryContainerBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <materialDesign:PackIcon x:Name="DetailsCardIcon" Kind="Account" Width="20" Height="20" Foreground="{DynamicResource OnPrimaryContainerBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="DetailsNameText" Text="Nama" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Border x:Name="DetailsSiteIdBadge" Style="{StaticResource M3.Tag}">
                                            <TextBlock x:Name="DetailsSiteIdText" Text="-" Style="{StaticResource Text.LabelMedium}" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                        </Border>
                                        <Border x:Name="DetailsPackageBadge" Style="{StaticResource M3.Tag}" Background="{DynamicResource SecondaryContainerBrush}">
                                            <TextBlock x:Name="DetailsPackageText" Text="-" Style="{StaticResource Text.LabelMedium}" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <Grid x:Name="DetailsAddressPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="MapMarkerOutline" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="DetailsAddressText" Grid.Column="1" Text="-" Style="{StaticResource Text.Supporting}"/>
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="BtnEditDetails" Grid.Column="2" Style="{StaticResource M3.IconButton}" Click="BtnEditDetails_Click"
                                        VerticalAlignment="Top" ToolTip="Ubah data" AutomationProperties.Name="Ubah data pelanggan">
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Fields -->
                        <Grid x:Name="FieldsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="NameFieldPanel" Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                <TextBox x:Name="FullNameBox" Style="{StaticResource M3.TextField}"
                                         materialDesign:HintAssist.Hint="Nama pelanggan *"
                                         materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                                         TextChanged="FullNameBox_TextChanged" AutomationProperties.Name="Nama pelanggan"/>
                                <TextBlock x:Name="NameWarningText" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel x:Name="PackageFieldPanel" Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <TextBox x:Name="PackageMbpsBox" Style="{StaticResource M3.TextField}"
                                         materialDesign:HintAssist.Hint="Kecepatan paket *"
                                         materialDesign:TextFieldAssist.SuffixText="Mbps"
                                         materialDesign:TextFieldAssist.LeadingIcon="Speedometer"
                                         TextChanged="PackageMbpsBox_TextChanged" AutomationProperties.Name="Kecepatan paket dalam Mbps"/>
                                <TextBlock x:Name="PackageWarningText" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel x:Name="AddressFieldPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                <TextBox x:Name="AddressBox" Style="{StaticResource M3.TextField}"
                                         materialDesign:HintAssist.Hint="Alamat pelanggan *"
                                         materialDesign:TextFieldAssist.LeadingIcon="MapMarkerOutline"
                                         TextChanged="AddressBox_TextChanged" AutomationProperties.Name="Alamat pelanggan"/>
                                <TextBlock x:Name="AddressWarningText" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>

                            <StackPanel x:Name="NotesFieldPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBox x:Name="NotesBox" Style="{StaticResource M3.TextField}" MinHeight="88"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         materialDesign:HintAssist.Hint="Catatan (opsional)"
                                         materialDesign:TextFieldAssist.LeadingIcon="NoteTextOutline"
                                         AutomationProperties.Name="Catatan"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource M3.TextButton}" Content="Kembali" Click="BackToLocation_Click" Margin="0,0,8,0"/>
                    <Button x:Name="StartTestBtn" Style="{StaticResource M3.FilledButton}" Click="StartTestBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="-8,0,8,0"/>
                            <TextBlock Text="Mulai pengujian" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 3. Running ═══ -->
        <Grid x:Name="ProgressContainer" Visibility="Collapsed">
            <Grid Margin="24" MaxWidth="840">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,8,0,24">
                    <TextBlock Text="Pengujian berjalan" Style="{StaticResource Text.HeadlineSmall}" Margin="0,0,0,4"/>
                    <TextBlock Text="Biarkan laptop tetap terhubung ke jaringan yang diuji sampai selesai." Style="{StaticResource Text.Supporting}"/>
                </StackPanel>

                <!-- Stepper: network → applications → bandwidth -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border x:Name="Step1Circle" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryBrush}">
                            <materialDesign:PackIcon x:Name="Step1Icon" Kind="LanConnect" Width="18" Height="18" Foreground="{DynamicResource OnPrimaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step1Text" Text="Jaringan" Style="{StaticResource Text.LabelLarge}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ProgressBar x:Name="Line1" Grid.Column="1" Style="{StaticResource M3.LinearProgress}" Height="2" Margin="12,0" VerticalAlignment="Center" Maximum="100"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border x:Name="Step2Circle" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SurfaceContainerHighestBrush}">
                            <materialDesign:PackIcon x:Name="Step2Icon" Kind="Web" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step2Text" Text="Aplikasi" Style="{StaticResource Text.LabelLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ProgressBar x:Name="Line2" Grid.Column="3" Style="{StaticResource M3.LinearProgress}" Height="2" Margin="12,0" VerticalAlignment="Center" Maximum="100"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Border x:Name="Step3Circle" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SurfaceContainerHighestBrush}">
                            <materialDesign:PackIcon x:Name="Step3Icon" Kind="Speedometer" Width="18" Height="18" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step3Text" Text="Bandwidth" Style="{StaticResource Text.LabelLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- What runs now -->
                <Border Grid.Row="2" Style="{StaticResource M3.FilledCard}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sedang diuji" Style="{StaticResource Text.LabelMedium}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CurrentActivityText" Text="Menyiapkan pengujian..." Style="{StaticResource Text.TitleLarge}"/>
                            </StackPanel>
                            <Border Style="{StaticResource M3.Tag}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0">
                                <TextBlock x:Name="TaskCountText" Text="Task 1 of 7" Style="{StaticResource Text.LabelMedium}" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                            </Border>
                        </Grid>
                        <ProgressBar x:Name="SubTaskProgressBar" Style="{StaticResource M3.LinearProgress}" Maximum="100" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SubTaskDetailText" Text="Menyiapkan mesin diagnostik..." Style="{StaticResource Text.Supporting}"/>
                    </StackPanel>
                </Border>

                <!-- Results as they arrive -->
                <Border Grid.Row="3" Style="{StaticResource M3.Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hasil yang sudah masuk" Style="{StaticResource Text.TitleMedium}" Margin="16,16,16,8"/>
                        <ScrollViewer x:Name="LogsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="160">
                            <StackPanel x:Name="DiagnosticLogsPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="EndTestBtn" Style="{StaticResource M3.ErrorTextButton}" Click="EndTestBtn_Click">
                        <TextBlock x:Name="EndTestBtnText" Text="Batalkan pengujian"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══ 4. Results ═══ -->
        <ScrollViewer x:Name="ResultsContainer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="24" MaxWidth="840" HorizontalAlignment="Stretch">
                <Grid Margin="0,8,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pengujian selesai" Style="{StaticResource Text.HeadlineSmall}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ResultSummaryText" Style="{StaticResource Text.Supporting}"/>
                    </StackPanel>

                    <!-- The verdict: status container, icon, word and score. -->
                    <Border x:Name="ResultStatusBadge" Grid.Column="1" CornerRadius="{StaticResource Shape.Card}" Padding="20,12" VerticalAlignment="Top"
                            Background="{DynamicResource StatusOnlineContainerBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="ResultStatusIcon" Kind="CheckCircle" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Foreground="{DynamicResource StatusOnlineOnContainerBrush}"/>
                            <StackPanel>
                                <TextBlock x:Name="ResultStatusText" Text="PASS" Style="{StaticResource Text.TitleLarge}" FontWeight="Medium"
                                           Foreground="{DynamicResource StatusOnlineOnContainerBrush}"/>
                                <TextBlock x:Name="ResultScoreText" Text="-" Style="{StaticResource Text.BodySmall}"
                                           Foreground="{DynamicResource StatusOnlineOnContainerBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Results the server did not store: said, never hidden behind a PASS. -->
                <Border x:Name="UnsavedWarning" Visibility="Collapsed" CornerRadius="{StaticResource Shape.Card}" Padding="16" Margin="0,0,0,16"
                        Background="{DynamicResource StatusWarningContainerBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="CloudAlert" Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,12,0"
                                                 Foreground="{DynamicResource StatusWarningOnContainerBrush}"/>
                        <TextBlock x:Name="UnsavedWarningText" Grid.Column="1" Style="{StaticResource Text.BodyMedium}"
                                   Foreground="{DynamicResource StatusWarningOnContainerBrush}"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="ResultCardsPanel"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="NewTestFromResults" Style="{StaticResource M3.TextButton}" Content="Pengujian baru" Click="NewTestFromResults_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RetryFailedBtn" Style="{StaticResource M3.TonalButton}" Click="RetryFailedBtn_Click" Visibility="Collapsed" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="-8,0,8,0"/>
                            <TextBlock Text="Uji ulang (sesi baru)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveReportBtn" Style="{StaticResource M3.FilledButton}" Click="SaveReportBtn_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="-8,0,8,0"/>
                            <TextBlock Text="Buka laporan" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

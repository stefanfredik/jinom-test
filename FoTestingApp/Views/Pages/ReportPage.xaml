<Page x:Class="FoTestingApp.Views.Pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Laporan">

    <!-- One session's certificate as a PDF: pick the session, see what it holds, save (primary), preview or print. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="840" HorizontalAlignment="Stretch">
            <TextBlock Text="Laporan sertifikasi" Style="{StaticResource Text.HeadlineSmall}" Margin="0,8,0,4"/>
            <TextBlock Text="Pilih sesi pengujian, lalu simpan, pratinjau atau cetak laporan PDF-nya." Style="{StaticResource Text.Supporting}" Margin="0,0,0,24"/>

            <Border Style="{StaticResource M3.Card}" Padding="24">
                <StackPanel>
                    <ComboBox x:Name="SessionComboBox" Style="{StaticResource M3.ComboField}"
                              IsEditable="True" TextSearch.TextPath="CertificationId"
                              materialDesign:HintAssist.Hint="Sesi pengujian (ID sesi)"
                              materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                              SelectionChanged="SessionComboBox_SelectionChanged"
                              HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="Sesi pengujian">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding CertificationId}" Style="{StaticResource Text.BodyLarge}"/>
                                    <TextBlock Style="{StaticResource Text.Supporting}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Customer.FullName, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding TestDate, Mode=OneWay, StringFormat='dd MMM yyyy, HH:mm'}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding OverallStatus, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- What the chosen session holds. -->
                    <Border x:Name="SessionSummary" Style="{StaticResource M3.FilledCard}" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SummaryTitle" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Supporting}"/>
                            </StackPanel>
                            <ContentControl x:Name="SummaryStatus" Grid.Column="1" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="WorkingBar" Style="{StaticResource M3.LinearProgress}" IsIndeterminate="True" Visibility="Hidden" Margin="0,16,0,0"/>

                    <StackPanel x:Name="StatusLine" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <materialDesign:PackIcon x:Name="StatusIcon" Kind="InformationOutline" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,8,0"/>
                        <TextBlock x:Name="ReportStatus" Style="{StaticResource Text.BodyMedium}" MaxWidth="700"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="PrintBtn" Style="{StaticResource M3.TextButton}" Click="PrintBtn_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cetak" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PreviewBtn" Style="{StaticResource M3.OutlinedButton}" Click="PreviewBtn_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="-8,0,8,0"/>
                                <TextBlock Text="Pratinjau" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportBtn" Style="{StaticResource M3.FilledButton}" Click="ExportBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center" Margin="-8,0,8,0"/>
                                <TextBlock Text="Simpan PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page x:Class="FoTestingApp.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Pengaturan">

    <!--
      Test parameters (saved to appsettings.json beside the app, for every user of this laptop) and the
      appearance (saved for this user only). Grouped in cards; each field says what it expects.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="840" HorizontalAlignment="Stretch">
            <TextBlock Text="Pengaturan" Style="{StaticResource Text.HeadlineSmall}" Margin="0,8,0,4"/>
            <TextBlock Text="Parameter pengujian berlaku untuk semua pengguna di laptop ini, mulai sesi berikutnya." Style="{StaticResource Text.Supporting}" Margin="0,0,0,24"/>

            <!-- Appearance -->
            <Border Style="{StaticResource M3.Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tampilan" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,4"/>
                    <TextBlock Text="Tersimpan untuk Anda saja dan langsung berlaku." Style="{StaticResource Text.Supporting}" Margin="0,0,0,16"/>
                    <WrapPanel>
                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource M3.FilterChip}" GroupName="Theme" Content="Ikuti Windows" Tag="System" Checked="Theme_Checked" Margin="0,0,8,0"/>
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource M3.FilterChip}" GroupName="Theme" Content="Terang" Tag="Light" Checked="Theme_Checked" Margin="0,0,8,0"/>
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource M3.FilterChip}" GroupName="Theme" Content="Gelap" Tag="Dark" Checked="Theme_Checked"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Ping -->
            <Border Style="{StaticResource M3.Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ping" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="GatewayTargetBox" Grid.Row="0" Grid.Column="0" Style="{StaticResource M3.TextField}" Margin="0,0,0,24"
                                 materialDesign:HintAssist.Hint="IP gateway"
                                 materialDesign:HintAssist.HelperText="Kosongkan agar dideteksi otomatis."
                                 AutomationProperties.Name="IP gateway"/>
                        <TextBox x:Name="PingGwCountBox" Grid.Row="0" Grid.Column="2" Style="{StaticResource M3.TextField}" Margin="0,0,0,24"
                                 materialDesign:HintAssist.Hint="Jumlah ping gateway"
                                 materialDesign:TextFieldAssist.SuffixText="paket"
                                 AutomationProperties.Name="Jumlah ping gateway"/>
                        <TextBox x:Name="DnsTargetBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource M3.TextField}" Margin="0,0,0,24"
                                 materialDesign:HintAssist.Hint="IP server DNS"
                                 materialDesign:HintAssist.HelperText="Pisahkan dengan koma."
                                 AutomationProperties.Name="IP server DNS"/>
                        <TextBox x:Name="PingDnsCountBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource M3.TextField}" Margin="0,0,0,24"
                                 materialDesign:HintAssist.Hint="Jumlah ping DNS"
                                 materialDesign:TextFieldAssist.SuffixText="paket"
                                 AutomationProperties.Name="Jumlah ping DNS"/>
                        <TextBox x:Name="PingLocalTargetBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource M3.TextField}" Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Domain ping lokal"
                                 materialDesign:HintAssist.HelperText="Pisahkan dengan koma."
                                 AutomationProperties.Name="Domain ping lokal"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DNS lookup -->
            <Border Style="{StaticResource M3.Card}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="NSLookup" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,16"/>
                    <TextBox x:Name="NslookupNasionalBox" Style="{StaticResource M3.TextField}" Margin="0,0,0,24"
                             materialDesign:HintAssist.Hint="Domain nasional"
                             materialDesign:HintAssist.HelperText="Pisahkan dengan koma."
                             AutomationProperties.Name="Domain nasional"/>
                    <TextBox x:Name="NslookupInternasionalBox" Style="{StaticResource M3.TextField}" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Domain internasional"
                             materialDesign:HintAssist.HelperText="Pisahkan dengan koma."
                             AutomationProperties.Name="Domain internasional"/>
                </StackPanel>
            </Border>

            <!-- Session -->
            <Border Style="{StaticResource M3.Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Sesi login" Style="{StaticResource Text.TitleMedium}" Margin="0,0,0,16"/>
                    <TextBox x:Name="SessionTimeoutBox" Style="{StaticResource M3.TextField}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Keluar otomatis setelah"
                             materialDesign:TextFieldAssist.SuffixText="menit"
                             materialDesign:HintAssist.HelperText="Tanpa aktivitas selama waktu ini."
                             AutomationProperties.Name="Keluar otomatis setelah berapa menit"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource M3.TextButton}" Content="Batalkan perubahan" Click="Reset_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource M3.FilledButton}" Content="Simpan pengaturan" Click="SaveSettingsBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page x:Class="FoTestingApp.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:charts="clr-namespace:FoTestingApp.Controls.Charts"
      Title="Riwayat">

    <!--
      The history and every session's report, as a list-detail screen (jinom-assets at a large
      width): counts and the sessions per day first (click a day to see it), then the filters
      (applied as they change), the sessions with a download per row, and one session's results
      beside them.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ List ═══ -->
        <Grid Grid.Column="0" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,8,0,24">
                <TextBlock Text="Riwayat &amp; laporan" Style="{StaticResource Text.HeadlineSmall}" Margin="0,0,0,4"/>
                <TextBlock Text="Sesi pengujian perusahaan Anda, terbaru di atas. Unduh laporan PDF dari setiap baris." Style="{StaticResource Text.Supporting}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Counts: number first, then the word; each status with its icon. -->
                <UniformGrid Grid.Column="0" Columns="2" Rows="2">
                    <Border Style="{StaticResource M3.FilledCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock x:Name="TotalSessionCount" Text="-" Style="{StaticResource Text.HeadlineSmall}"/>
                            <TextBlock Text="Total sesi" Style="{StaticResource Text.Supporting}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource M3.FilledCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock x:Name="TotalPassCount" Text="-" Style="{StaticResource Text.HeadlineSmall}"/>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Foreground="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="PASS" Style="{StaticResource Text.Supporting}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource M3.FilledCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock x:Name="TotalPartialCount" Text="-" Style="{StaticResource Text.HeadlineSmall}"/>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16" Foreground="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="PARTIAL" Style="{StaticResource Text.Supporting}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource M3.FilledCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock x:Name="TotalFailCount" Text="-" Style="{StaticResource Text.HeadlineSmall}"/>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="{DynamicResource StatusOfflineBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="FAIL" Style="{StaticResource Text.Supporting}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Sessions per day, stacked by verdict; hover for the counts, click a bar to see that day. -->
                <Border Grid.Column="1" Style="{StaticResource M3.Card}" Padding="16,12,16,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,4">
                            <TextBlock x:Name="TrendTitle" Text="Sesi per hari" Style="{StaticResource Text.TitleMedium}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="{DynamicResource StatusOnlineBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="PASS" Style="{StaticResource Text.LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon Kind="AlertCircle" Width="14" Height="14" Foreground="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="PARTIAL" Style="{StaticResource Text.LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14" Foreground="{DynamicResource StatusOfflineBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="FAIL" Style="{StaticResource Text.LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <charts:SessionTrendChart x:Name="TrendChart" Grid.Row="1" Height="136" PeriodSelected="TrendChart_PeriodSelected"
                                                  AutomationProperties.Name="Jumlah sesi per hari menurut status"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Filters -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <WrapPanel VerticalAlignment="Center">
                    <DatePicker x:Name="FromDatePicker" Style="{StaticResource M3.DateField}" Width="170" Margin="0,0,12,8"
                                materialDesign:HintAssist.Hint="Dari tanggal" SelectedDateChanged="Filter_Changed"
                                AutomationProperties.Name="Dari tanggal"/>
                    <DatePicker x:Name="ToDatePicker" Style="{StaticResource M3.DateField}" Width="170" Margin="0,0,24,8"
                                materialDesign:HintAssist.Hint="Sampai tanggal" SelectedDateChanged="Filter_Changed"
                                AutomationProperties.Name="Sampai tanggal"/>
                    <RadioButton x:Name="StatusAll" Style="{StaticResource M3.FilterChip}" GroupName="Status" Content="Semua" Tag="" IsChecked="True"
                                 Checked="Filter_Changed" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <RadioButton Style="{StaticResource M3.FilterChip}" GroupName="Status" Content="PASS" Tag="PASS"
                                 Checked="Filter_Changed" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <RadioButton Style="{StaticResource M3.FilterChip}" GroupName="Status" Content="PARTIAL" Tag="PARTIAL"
                                 Checked="Filter_Changed" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <RadioButton Style="{StaticResource M3.FilterChip}" GroupName="Status" Content="FAIL" Tag="FAIL"
                                 Checked="Filter_Changed" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Button Style="{StaticResource M3.IconButton}" Click="Refresh_Click" VerticalAlignment="Center" Margin="0,0,0,8"
                            ToolTip="Muat ulang" AutomationProperties.Name="Muat ulang riwayat">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                    </Button>
                </WrapPanel>
                <!-- A failed load or a list the server cut off is said, never shown as "0". -->
                <TextBlock x:Name="ListNotice" Visibility="Collapsed" Style="{StaticResource Text.BodySmall}" Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Sessions -->
            <Border Grid.Row="3" Style="{StaticResource M3.Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="SessionsGrid" Style="{StaticResource M3.DataGrid}" RowHeight="56"
                              SelectionChanged="SessionsGrid_SelectionChanged" Cursor="Hand"
                              AutomationProperties.Name="Daftar sesi pengujian">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID sesi" Binding="{Binding CertificationId}" Width="180"/>
                            <DataGridTextColumn Header="Lokasi" Binding="{Binding Customer.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Jenis" Binding="{Binding Customer.SiteTypeText}" Width="100"/>
                            <DataGridTextColumn Header="Paket" Binding="{Binding Customer.PackageText}" Width="100"/>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding TestDate, StringFormat='dd MMM yyyy, HH:mm'}" Width="160"/>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{StaticResource Shape.Chip}" Padding="8,4,12,4" HorizontalAlignment="Left"
                                                Background="{Binding OverallStatus, Converter={StaticResource StatusToBackgroundConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="{Binding OverallStatus, Converter={StaticResource StatusToIconConverter}}" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                                                         Foreground="{Binding OverallStatus, Converter={StaticResource StatusToForegroundConverter}}"/>
                                                <TextBlock Text="{Binding OverallStatus}" Style="{StaticResource Text.LabelLarge}"
                                                           Foreground="{Binding OverallStatus, Converter={StaticResource StatusToForegroundConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- The session's report, straight from its row. -->
                            <DataGridTemplateColumn Header="Laporan" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource M3.IconButton}" Click="DownloadRow_Click" HorizontalAlignment="Left"
                                                ToolTip="Unduh laporan PDF" AutomationProperties.Name="Unduh laporan PDF">
                                            <materialDesign:PackIcon Kind="Download" Width="20" Height="20"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Nothing to show: say so, and what to do. -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <materialDesign:PackIcon Kind="ClipboardTextSearchOutline" Width="48" Height="48" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Belum ada sesi pada filter ini" Style="{StaticResource Text.TitleMedium}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Ubah rentang tanggal atau status, atau mulai pengujian baru." Style="{StaticResource Text.Supporting}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Detail ═══ -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceContainerLowBrush}">
            <Grid x:Name="DetailPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,24,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="Detail" Style="{StaticResource Text.TitleLarge}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailSubtitle" Style="{StaticResource Text.Supporting}" Margin="0,0,0,12"/>
                        <ContentControl x:Name="DetailStatus"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource M3.IconButton}" Click="CloseDetail_Click" VerticalAlignment="Top"
                            ToolTip="Tutup" AutomationProperties.Name="Tutup detail">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0,8,16">
                        <!-- The session at a glance: latency and download against their limits. -->
                        <StackPanel x:Name="DetailCharts" Visibility="Collapsed" Margin="16,0,16,16">
                            <TextBlock x:Name="DetailLatencyTitle" Text="Latensi rata-rata" Style="{StaticResource Text.LabelLarge}" Margin="0,0,0,4"/>
                            <charts:BulletChart x:Name="DetailLatency" AutomationProperties.Name="Latensi rata-rata per target"/>
                            <TextBlock x:Name="DetailSpeedTitle" Text="Kecepatan download" Style="{StaticResource Text.LabelLarge}" Margin="0,12,0,4"/>
                            <charts:BulletChart x:Name="DetailSpeed" AutomationProperties.Name="Kecepatan download per speedtest"/>
                        </StackPanel>
                        <StackPanel x:Name="DetailResultsPanel"/>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" x:Name="DetailReportBtn" Style="{StaticResource M3.FilledButton}" Margin="24,8,24,24"
                        HorizontalAlignment="Stretch" Click="DetailReport_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Unduh laporan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>

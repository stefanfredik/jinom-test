<Window x:Class="FoTestingApp.Views.MainShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:FoTestingApp.Helpers"
        Title="Jinom Test"
        Icon="pack://application:,,,/Resources/jinom.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource SurfaceBrush}">

    <!--
      The main window, laid out like jinom-assets at a large width: a navigation drawer on the left
      (active item on a secondary-container pill), the page on the right. Dialogs open in RootDialog
      (28 px, surface-container-high, over a scrim); short messages show in the snackbar.
    -->
    <materialDesign:DialogHost x:Name="RootDialogHost" Identifier="RootDialog"
                               DialogBackground="{DynamicResource SurfaceContainerHighBrush}"
                               DialogContentUniformCornerRadius="28"
                               OverlayBackground="{DynamicResource ScrimBrush}"
                               CloseOnClickAway="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Navigation drawer ═══ -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerLowBrush}">
                <Grid Margin="12,16,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,4,16,24">
                        <Image Source="pack://application:,,,/Resources/jinom_logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Jinom Test" Style="{StaticResource Text.TitleMedium}"/>
                            <TextBlock Text="Sertifikasi jaringan" Style="{StaticResource Text.BodySmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Destinations -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavNewTest" Style="{StaticResource M3.NavItem}" GroupName="Nav" Tag="NewTest"
                                     Checked="Nav_Checked" AutomationProperties.Name="Pengujian baru">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Pengujian baru" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <!-- The history holds every session's report (download per row): no separate report page. -->
                        <RadioButton x:Name="NavHistory" Style="{StaticResource M3.NavItem}" GroupName="Nav" Tag="Dashboard"
                                     Checked="Nav_Checked" AutomationProperties.Name="Riwayat dan laporan">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Riwayat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer: theme and the signed-in technician -->
                    <StackPanel Grid.Row="3">
                        <Button x:Name="ThemeToggle" Style="{StaticResource M3.TextButton}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="16,0" Margin="0,0,0,8" Click="ThemeToggle_Click"
                                AutomationProperties.Name="Ganti tema terang atau gelap">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="ThemeLabel" Text="Mode gelap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource M3.Divider}" Margin="8,0,8,12"/>

                        <Grid Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PrimaryContainerBrush}">
                                <TextBlock x:Name="UserInitials" Text="JT" Style="{StaticResource Text.LabelLarge}"
                                           Foreground="{DynamicResource OnPrimaryContainerBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameLabel" Text="Teknisi" Style="{StaticResource Text.LabelLarge}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UserEmailLabel" Text="-" Style="{StaticResource Text.BodySmall}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource M3.IconButton}" Click="LogoutButton_Click"
                                    ToolTip="Keluar" AutomationProperties.Name="Keluar">
                                <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Page ═══ -->
            <Grid Grid.Column="1">
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent" Focusable="False"/>

                <!-- From the history, the way to start the next test. -->
                <Button x:Name="FabNewTest" Style="{StaticResource M3.ExtendedFab}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                        Click="FabNewTest_Click" Visibility="Collapsed" AutomationProperties.Name="Mulai pengujian baru">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Pengujian baru" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <materialDesign:Snackbar MessageQueue="{x:Static helpers:Ui.Messages}"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>

<Window x:Class="FoTestingApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Jinom Test"
        Icon="pack://application:,,,/Resources/jinom.ico"
        Height="560" Width="440" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource SurfaceBrush}">

    <!--
      Sign in, nothing else: the logo, the two fields and one action. The only text that appears is
      why a sign-in failed. The last email used on this laptop is filled in.
    -->
    <StackPanel VerticalAlignment="Center" Margin="48,0">
        <Image Source="pack://application:,,,/Resources/jinom_logo.png" Width="72" Height="72" Margin="0,0,0,40"
               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Jinom"/>

        <TextBox x:Name="EmailTextBox" Style="{StaticResource M3.TextField}" Margin="0,0,0,16"
                 materialDesign:HintAssist.Hint="Email"
                 materialDesign:TextFieldAssist.LeadingIcon="EmailOutline"
                 AutomationProperties.Name="Email"/>

        <PasswordBox x:Name="PasswordBox" Style="{StaticResource M3.PasswordField}"
                     materialDesign:HintAssist.Hint="Password"
                     materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                     AutomationProperties.Name="Password"/>

        <!-- Why the last attempt failed, under the fields. -->
        <Border x:Name="ErrorPanel" Background="{DynamicResource ErrorContainerBrush}" CornerRadius="{StaticResource Shape.Chip}"
                Padding="12,8" Margin="0,16,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource OnErrorContainerBrush}"
                                         VerticalAlignment="Top" Margin="0,1,8,0"/>
                <TextBlock x:Name="ErrorMessage" Grid.Column="1" Style="{StaticResource Text.BodyMedium}" Foreground="{DynamicResource OnErrorContainerBrush}"/>
            </Grid>
        </Border>

        <Button x:Name="LoginButton" Style="{StaticResource M3.FilledButton}" HorizontalAlignment="Stretch" Margin="0,24,0,0"
                IsDefault="True" Click="LoginButton_Click">
            <TextBlock x:Name="LoginButtonText" Text="Masuk"/>
        </Button>

        <ProgressBar x:Name="LoadingBar" Style="{StaticResource M3.LinearProgress}" IsIndeterminate="True"
                     Visibility="Hidden" Margin="0,16,0,0"/>
    </StackPanel>
</Window>

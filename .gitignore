# ──────────────────────────────────────────
# .gitignore — FoTestingApp (WPF / .NET 8)
# ──────────────────────────────────────────

# ── Build output ──────────────────────────
**/bin/
**/obj/

# ── Publish output ────────────────────────
**/publish/
dist/

# ── NuGet packages (restored on build) ───
*.nupkg
**/packages/
!**/packages/build/

# ── Visual Studio ──────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.pidb
*.svclog
*.scc
_Upgrade Report Files/

# ── Rider / JetBrains ─────────────────────
.idea/
*.DotSettings.user

# ── VS Code ───────────────────────────────
.vscode/

# ── OS files ──────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db

# ── Application logs ──────────────────────
**/Logs/
*.log

# ── Packaging & installer output ──────────
SingleFilePacker/
Output/
Setup*.exe

# ── Sensitive config (never commit secrets) ─
# appsettings.Production.json
# appsettings.local.json